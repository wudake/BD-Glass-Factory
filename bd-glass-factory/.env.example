# Resend Email API
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender email address
# For testing: use "onboarding@resend.dev" (Resend default)
# For production: verify your domain at https://resend.com/domains and use "info@bdglassfactory.com"
FROM_EMAIL=info@bdglassfactory.com

# Notification recipient (your internal email)
NOTIFY_EMAIL=info@bdglassfactory.com

# Cloudflare Turnstile (bot protection)
# Create widget at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
TURNSTILE_SECRET_KEY=0x4AAAA...

# Search Engine Verification
# Google Search Console → Settings → Ownership verification → HTML tag
NEXT_PUBLIC_GOOGLE_VERIFICATION=
# Bing Webmaster Tools → Settings → Ownership verification → Meta tag
NEXT_PUBLIC_BING_VERIFICATION=
# Yandex Webmaster → Site settings → Access rights → Meta tag
NEXT_PUBLIC_YANDEX_VERIFICATION=
